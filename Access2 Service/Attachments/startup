-tnxnp
-nt
setenv SHELL mshell
setenv TZ GMT:no
tmode -w=1 nopause
*
*   OS9 For Embedded Systems (X86) V1.0
*   Copyright 1996, 1997, 1998 by Microware Systems Corporation
*
*   The commands in this file are highly system dependent and should
*   be modified by the user.
*
*setime </term                 		;* start system clock
setime -s	                 		;* start system clock
link mshell csl                		;* make "shell" and "csl" stay in memory
* iniz r0 h0 d0 t1 p1 term    		;* initialize devices
* load utils                  		;* make some utilities stay in memory
* tsmon /term /t1 &                 ;* start other terminals
* list sys/motd
setenv TERM pcat
* Let's disable diskcache for now
*diskcache -e /h0=1024k              ;* Use disk cache to speed transfers
*
alias /dd /h0                     	;* In case of no RAM disk remove comment
tmode -w=1 pause
* Set the Enviornment Path
setenv PATH /h0/CMDS:/SCRIPS:/SCRIPTUTIL
setenv MWOS /h0/MWOS                ;* Setup MWOS enviorment
* Make some commands look like DOS
assign h hist
assign cd chd
assign ls (dir -u)
assign type list
* Setup Nexstep aliases
alias /ACCESS /h0/NEXSTEP
alias /NEXSTEP /ACCESS
alias /BIN /NEXSTEP/BIN
alias /DRO /NEXSTEP/DRO
alias /DRV /NEXSTEP/DRV
alias /DRW /NEXSTEP/DRW
alias /CFG /NEXSTEP/CFG
alias /SMC_DESC /qsmcdesc
alias /UICFG /NEXSTEP/DRO/UICONFIG
alias /UTILS /NEXSTEP/UTILS
alias /MSGBACK /NEXSTEP/MSGBACK
alias /TEST /NEXSTEP/TEST
alias /SCRIPTS /NEXSTEP/SCRIPTS
alias /SCRIPTUTIL /NEXSTEP/SCRIPTUTIL
alias /STATE /NEXSTEP/STATE
alias /LOG /NEXSTEP/LOG
* Make sure LOG directory exist
if (!exist("/LOG"))
    cd /NEXSTEP
    makdir LOG
    cd /H0
endif 
* Make sure MSGBACK directory exist
if (!exist("/MSGBACK"))
    cd /NEXSTEP
    makdir MSGBACK
    cd /H0
endif    
   
*
*
* Use multi-term.
*
iniz mterm1 mterm2 mterm3
iniz /r0
*
* Override the default compiled addresses.
*ifconfig enet0 134.217.55.27 broadcast 134.217.255.255 netmask 255.255.0.0
*
* Override the default compiled addresses.
*
ifconfig enet0 192.168.2.4 broadcast 192.168.2.255 netmask 255.255.255.0
setenv _sh -1
mshell     -elsp="@(OS9_w1)[%p/>] "    <>>>/mterm1&
setenv _sh -1
mshell     -elsp="@(OS9_w2)[%p/>] "    <>>>/mterm2&
setenv _sh -1
mshell     -elsp="@(OS9_w3)[%p/>] "    <>>>/mterm3&
*
* Save old log files
*
cd /LOG
** Dispatcher
if(exist("logdisp.log_old"))
	del logdisp.log_old
   unlink del
endif
if(exist("logdisp.log"))
	rename logdisp.log logdisp.log_old
   unlink rename
endif
** Instrument controller
if(exist("loginst.log_old"))
	del loginst.log_old
   unlink del
endif
if(exist("loginst.log"))
	rename loginst.log loginst.log_old
   unlink rename
endif
** Partial comm
if(exist("comm.log_old"))
	del comm.log_old
   unlink del
endif
if(exist("comm.log"))
	rename comm.log comm.log_old
   unlink rename
endif
** Sequencer
if(exist("sequencer.log_old"))
	del sequencer.log_old
   unlink del
endif
if(exist("sequencer.log"))
	rename sequencer.log sequencer.log_old
   unlink rename
endif
** COMM
if(exist("comm.log"))
	del comm.log*
   unlink del
endif
cd /h0
* Perform System Initialization
(chd /scripts;modb.sh)
*
setenv _sh 0
ex mshell -elsp="@(OS9_w0)[%p/>] " <>>>/term&
